# ==============================================================================
# CrystalCore .gitignore
# ==============================================================================

# --- Secrets & Environment Variables (CRITICAL) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- Python Virtual Environments ---
venv/
.venv/
backend/venv/
backend/.venv/
*/venv/
*/.venv/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node & Frontend Dependencies ---
node_modules/
frontend_react/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# --- Editor & IDE Files ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Temporary & Log Files ---
*.log
tmp/
scratch/
